# Copy this file to .env and fill in real values. .env is gitignored - never
# commit real credentials.
#
# For Gmail: turn on 2-Step Verification, then create an "app password" at
# https://myaccount.google.com/apppasswords - use that here, not your normal
# Gmail password.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-16-character-app-password
DIGEST_TO=you@gmail.com
